# RGNR8 configuration — copy to .env and fill in. Never commit real secrets.
# Everything is read by rgnr8_ops.Settings.from_env (validated at startup).

# --- database ---------------------------------------------------------------
# Postgres in prod; omit for in-memory dev (not durable).
RGNR8_DATABASE_URL=postgresql://rgnr8:rgnr8@db:5432/rgnr8

# --- auth -------------------------------------------------------------------
# One of: hs256 | jwks | static
RGNR8_AUTH_MODE=hs256
# hs256: a signing secret for self-issued session tokens
RGNR8_JWT_SECRET=change-me-to-a-long-random-string
# jwks (real IdP — Auth0/Okta/Cognito/Entra): point these at your tenant
# RGNR8_AUTH_MODE=jwks
# RGNR8_JWKS_URL=https://YOUR_TENANT/.well-known/jwks.json
# RGNR8_JWT_ISSUER=https://YOUR_TENANT/
# RGNR8_JWT_AUDIENCE=rgnr8-api
RGNR8_TENANT_CLAIM=tenant

# --- web --------------------------------------------------------------------
RGNR8_PORT=8080
RGNR8_WORKERS=4

# --- secrets at rest --------------------------------------------------------
# Encrypts stored OAuth tokens (QBO) at rest. Generate once and keep in your
# secret manager; losing it means stored tokens can't be decrypted (reconnect).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# RGNR8_SECRET_KEY=

# --- observability (optional) -----------------------------------------------
# When set, unhandled errors are reported to Sentry; otherwise they are logged.
# SENTRY_DSN=

# --- delivery (optional until you turn it on) -------------------------------
# RGNR8_SENDGRID_API_KEY=
# RGNR8_FCM_API_KEY=
RGNR8_DELIVERY_FROM=briefings@rgnr8.app

# --- connectors / QBO (optional until you connect data) ---------------------
# RGNR8_PLAID_CLIENT_ID=
# RGNR8_PLAID_SECRET=
# RGNR8_GUSTO_API_KEY=
# RGNR8_QBO_CLIENT_ID=
# RGNR8_QBO_CLIENT_SECRET=
