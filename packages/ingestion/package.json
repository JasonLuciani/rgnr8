{
  "name": "@rgnr8/ingestion",
  "version": "0.1.0",
  "description": "RGNR8 ingestion — normalize raw bank/card/payroll payloads into canonical transactions (dedupe, pending→posted, transfer detection, provenance) and map them to ledger posting commands.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@rgnr8/ledger-kernel": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
