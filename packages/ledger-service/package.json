{
  "name": "@rgnr8/ledger-service",
  "version": "0.1.0",
  "description": "The RGNR8 accounting core as a running HTTP service — chart of accounts, journal posting, register, trial balance, statements, go-live.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "rgnr8-ledger-service": "dist/bin.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "node dist/bin.js"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@rgnr8/ledger-kernel": "^0.1.0",
    "@rgnr8/ledger-postgres": "^0.1.0",
    "@rgnr8/financial-statements": "^0.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.11.10",
    "pg-mem": "^3.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
