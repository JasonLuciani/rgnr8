{
  "name": "@rgnr8/forecast-inputs",
  "version": "0.1.0",
  "description": "Emit the Python forecast engine's ForecastInputs contract from reconciled ingestion data — opening cash gated on a clean reconciliation, plus recurring-flow detection.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@rgnr8/ledger-kernel": "^0.1.0",
    "@rgnr8/ingestion": "^0.1.0",
    "@rgnr8/reconciliation": "^0.1.0"
  },
  "devDependencies": {
    "@rgnr8/subledger": "^0.1.0",
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
